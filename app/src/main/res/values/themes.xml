<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A bare no-action-bar theme. All real colors/typography are handled in
         Compose (see WakeWellTheme). We set a dark startup background so the app
         doesn't flash white before Compose draws. -->
    <style name="Theme.WakeWell" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
