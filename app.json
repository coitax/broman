{
  "expo": {
    "name": "Morning",
    "slug": "morning",
    "scheme": "morning",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E1530"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morning.app"
    },
    "android": {
      "package": "com.morning.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
